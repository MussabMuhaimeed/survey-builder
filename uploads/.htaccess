# Uploads can only be images and videos: code is never executed here
Options -Indexes -ExecCGI
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh|htaccess)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header set Content-Security-Policy "default-src 'none'; img-src 'self' data:; media-src 'self'; style-src 'unsafe-inline'"
  Header set X-Content-Type-Options "nosniff"
</IfModule>

# Internal flags (e.g. .schema-version)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
